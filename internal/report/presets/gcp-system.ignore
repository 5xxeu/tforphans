# Objects that Google Cloud and GKE create on their own. Only marks a user
# cannot give their own objects count: label keys starting with goog-,
# which Google reserves, and service account and bucket names in Google's
# own domains. Names alone (gke-*, k8s-*) are not enough: anyone who can
# create a firewall rule can call it gke-public-ssh. Built from one large
# project's results; check what it hides before relying on it.
#
# GKE also creates firewall rules and health checks (k8s-fw-*,
# k8s-*-node-hc, k8s2-*); GCP gives them no reserved mark, only names and
# descriptions anyone can set. The separate preset gcp-gke-names hides them
# by those, if you accept that.

# GKE nodes, their boot disks and persistent volume disks
google_compute_instance attr.labels.goog-gke-node=*
google_compute_instance attr.labels.goog-k8s-cluster-name=*
google_compute_disk attr.labels.goog-gke-node=*
google_compute_disk attr.labels.goog-k8s-cluster-name=*
google_compute_disk attr.labels.goog-gke-volume=*

# Default service accounts (Google-owned domains)
google_service_account email=*-compute@developer.gserviceaccount.com
google_service_account email=*@appspot.gserviceaccount.com

# App Engine buckets (only Google can create buckets under appspot.com)
google_storage_bucket name=*.appspot.com
